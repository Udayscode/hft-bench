#!/usr/bin/env bash
# =============================================================================
# CPU CORE ALLOCATION LAYOUT — hft-bench
# =============================================================================
# Source this file from tune_system.sh and run-orchestrator.sh.
#
# PHYSICAL TOPOLOGY (AMD Ryzen 5 7530U / 6-core SMT / 12 logical CPUs)
# Override all variables below for your bare-metal target.
#
#   Physical Core 0  → logical CPUs  0, 1  → OS scheduler + general services
#   Physical Core 1  → logical CPUs  2, 3  → Firecracker microVM vCPUs
#   Physical Core 2  → logical CPUs  4, 5  → bot-fleet workers 0–3
#   Physical Core 3  → logical CPUs  6, 7  → bot-fleet workers 4–7
#   Physical Core 4  → logical CPUs  8, 9  → shadow-engine reference matcher
#   Physical Core 5  → logical CPUs 10,11  → orchestrator + redpanda + telemetry
#
# On bare metal with isolcpus, add to GRUB_CMDLINE_LINUX in /etc/default/grub:
#   isolcpus=2-9 nohz_full=2-9 rcu_nocbs=2-9 nosoftlockup
# Then: sudo update-grub && sudo reboot
# =============================================================================

# ── Trading / latency-critical cores (PROTECTED from IRQs and OS scheduler) ──
export FC_VCPU_CORES="2,3"           # Guest VM vCPU execution (supports up to 2 concurrent VMs without SMT overlap)
export BOTFLEET_CORES="4,5"          # bot-fleet Tokio worker threads
export SHADOW_ENGINE_CORES="6,7"     # shadow-engine reference matcher

# ── System / infrastructure cores ────────────────────────────────────────────
export OS_CORES="0,1"                # OS scheduler + general kernel tasks
export SYSTEM_CORES="8,9,10,11"      # orchestrator + redpanda + telemetry-ingester
export ORCH_CORES="8,9"              # sandbox-orchestrator process affinity

# ── IRQ routing ───────────────────────────────────────────────────────────────
# All hardware interrupts are steered to OS_CORES + SYSTEM_CORES.
# Trading cores (FC_VCPU_CORES + BOTFLEET_CORES + SHADOW_ENGINE_CORES) are
# completely shielded from interrupt delivery.
export IRQ_ALLOWED_CORES="0,1,8,9,10,11"
# Hex bitmask for /proc/irq/*/smp_affinity:
#   bits 0,1,8,9,10,11 set → 1111_0000_0011 = 0xF03
export IRQ_ALLOWED_MASK="f03"

# ── Derived values used by tune_system.sh ────────────────────────────────────
# All protected cores (no IRQs, no OS tasks in isolcpus mode)
export PROTECTED_CORES="2,3,4,5,6,7"

# ── GRUB parameters for isolcpus mode (bare metal only) ─────────────────────
# These CANNOT be applied at runtime — they require a reboot.
export GRUB_ISOLCPUS_PARAMS="isolcpus=2-7 nohz_full=2-7 rcu_nocbs=2-7 nosoftlockup mitigations=off"
